# Kyverance Simplified web — local development (no real secrets)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Local development identity (Auth.js Credentials + backend DEV_AUTH).
# Impossible in production builds: AUTH_DEV_IDENTITY is ignored when NODE_ENV=production.
NEXT_PUBLIC_DEV_AUTH=true
AUTH_DEV_IDENTITY=true

# Auth.js session encryption (generate a long random string locally)
AUTH_SECRET=change-me-to-a-long-random-string-for-local-dev-only
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Preferred Entra External ID variables (provision later — leave empty for local-only)
AUTH_ENTRA_CLIENT_ID=
AUTH_ENTRA_CLIENT_SECRET=
AUTH_ENTRA_TENANT_ID=
AUTH_ENTRA_CIAM_DOMAIN=
AUTH_ENTRA_USER_FLOW=SignUpSignIn
AUTH_ENTRA_API_SCOPE=api://kyverance-api/access_as_user
AUTH_ENTRA_ISSUER=

# Auth.js Microsoft Entra provider aliases (also accepted; used by CI)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
