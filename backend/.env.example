# Kyverance Simplified API — local development (no real secrets)
APP_ENV=local
DEV_AUTH=true
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_URL=postgresql+psycopg://kyverance:kyverance@localhost:5432/kyverance
REDIS_URL=redis://localhost:6379/0

# Entra External ID — placeholders only; provision in a later Azure/Entra task
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_WEB_CLIENT_ID=
ENTRA_AUDIENCE=api://kyverance-api
ENTRA_ISSUER=
ENTRA_JWKS_URL=

# Optional Key Vault (leave empty for local-only work)
KEY_VAULT_URL=

# Plaid — leave empty to use the local fake provider (no live banking)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_SANDBOX_SECRET=
PLAID_ENV=sandbox
# Optional; local/test uses a deterministic non-production fallback when unset
PLAID_TOKEN_ENCRYPTION_KEY=

# Simulation quotes — fixture only in SIM-02 (no live market data)
QUOTE_MODE=fixture

# Market-data warehouse (MRKT-01) — fake provider by default; no live credentials required
MARKET_DATA_PROVIDER=fake
MARKET_DATA_ENGINE_ENABLED=true
MARKET_DATA_JOBS_ENABLED=true
# Leave empty. Live adapter stays disabled in this slice even if set.
MARKET_DATA_LIVE_API_TOKEN=
MARKET_DATA_US_PRIMARY_EXCHANGE=XNAS
MARKET_DATA_WORKER_MODE=once
MARKET_DATA_STALE_TOLERANCE_MINUTES=1440

# Canonical research jobs (RSRCH-01) — deterministic / AI-off by default
RESEARCH_ENGINE_ENABLED=true
RESEARCH_JOBS_ENABLED=true
RESEARCH_AI_ENABLED=false
RESEARCH_DATA_MODE=internal
RESEARCH_ARTIFACT_BACKEND=local
RESEARCH_ARTIFACT_ROOT=
RESEARCH_WORKER_MODE=once
RESEARCH_EOD_FINALIZE_LAG_MINUTES=90
