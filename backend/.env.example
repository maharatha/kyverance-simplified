# Kyverance Simplified API — local development (no real secrets)
DEV_AUTH=true
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_URL=postgresql+psycopg://kyverance:kyverance@localhost:5432/kyverance
REDIS_URL=redis://localhost:6379/0

# Entra External ID — placeholders only; configure in a later identity task
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_WEB_CLIENT_ID=
ENTRA_AUDIENCE=api://kyverance-api
ENTRA_ISSUER=

# Optional Key Vault (leave empty for local-only work)
KEY_VAULT_URL=
